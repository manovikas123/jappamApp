{
  "appId": "com.joshi.JappamCounter",
  "appName": "JappamCounter",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#000000"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#7C3AED",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}